# systemd EnvironmentFile syntax, NOT a shell script. Never commit real tokens.
HOST=127.0.0.1
PORT=8787
STATE_DIR=/var/lib/sendspin-karaoke
# Start safely with local demo assets until Music Assistant is configured.
DEMO_MODE=true
# Uncomment and fill ALL four MA fields before setting DEMO_MODE=false.
# MA_URL=http://music-assistant.local:8095
# MA_TOKEN=replace-with-your-token
# MA_PLAYER_ID=replace-with-player-id
# MA_QUEUE_ID=replace-with-queue-id
# Opt in only if MA may refresh/write library metadata while fetching lyrics.
MA_ALLOW_LYRICS_REFRESH=false
# Opt in to direct HTTPS Spotify cover downloads from i.scdn.co (no MA token sent).
MA_ALLOW_SPOTIFY_ARTWORK=false
CEC_ENABLED=false
# Opt-in built-in Pi CEC remote navigation; ignored in demo or with CEC disabled.
CEC_REMOTE_ENABLED=false
CEC_DEVICE=/dev/cec0
# Legacy one-shot adapter only; ignored when CEC_REMOTE_ENABLED=true.
# CEC_ADAPTER=/dev/cec0
CEC_ALLOW_STANDBY=false
# Optional cached Line-in album view and retry-only IPC. Both values required; source 0.5+.
# No source identity, consent, pairing or recording control access is granted.
# Obtain source_id from the source user's recognition-status; UID from id -u sendspin-karaoke-source.
# LINE_IN_ALBUM_SOURCE_ID=64-lowercase-hex-SHA256-of-source-public-identity
# LINE_IN_ALBUM_SOURCE_UID=source-service-numeric-uid
# Source 0.6+ tools reuse the complete album ID/UID pair by default. To configure
# passive meters, completed-recording tools and health without recognition, set BOTH:
# SOURCE_TOOLS_SOURCE_ID=64-lowercase-hex-SHA256-of-source-public-identity
# SOURCE_TOOLS_SOURCE_UID=source-service-numeric-uid
# Partial/invalid pairs reject startup. Explicit tools identity overrides album identity,
# but attaching an album from a different source is rejected. Original audio is unchanged.
