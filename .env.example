# Copy to .env for local use, or /etc/sendspin-karaoke/environment on the Pi.
# Never commit the populated file. Keep it readable only by the service/operator.
HOST=127.0.0.1
PORT=8787
STATE_DIR=./state

# Explicit synthetic simulator; set false and configure all MA values for live use.
DEMO_MODE=true
# MA_URL=http://music-assistant.local:8095
# MA_TOKEN=replace-with-a-music-assistant-long-lived-token
# Exact IDs from your MA installation; display names are not IDs.
# MA_PLAYER_ID=replace-with-cast-player-id
# MA_QUEUE_ID=replace-with-queue-id
# MA's lyrics endpoint may enrich/write library metadata. Opt in only after review.
MA_ALLOW_LYRICS_REFRESH=false
# Opt in to direct HTTPS Spotify cover downloads from i.scdn.co (no MA token sent).
MA_ALLOW_SPOTIFY_ARTWORK=false

CEC_ENABLED=false
# Native Pi built-in CEC remote input (also requires CEC_ENABLED=true and DEMO_MODE=false).
CEC_REMOTE_ENABLED=false
# Exact kernel character device for the connected HDMI port; inspect before enabling.
CEC_DEVICE=/dev/cec0
# Optional one-shot libCEC adapter; ignored while native remote input is enabled.
# CEC_ADAPTER=
# Standby remains unsupported even if this is true; no automatic power actions.
CEC_ALLOW_STANDBY=false
# Optional local album metadata and retry-only IPC (Linux installed services, source 0.5+).
# LINE_IN_ALBUM_SOURCE_ID=64-lowercase-hex-SHA256-of-source-public-identity
# LINE_IN_ALBUM_SOURCE_UID=source-service-numeric-uid
# Source 0.6+ tools (passive meters, completed recordings, health) reuse the complete
# album ID/UID pair by default. Configure BOTH below to use tools without recognition.
# Partial/invalid pairs reject startup; different tools/album sources cannot attach metadata.
# SOURCE_TOOLS_SOURCE_ID=64-lowercase-hex-SHA256-of-source-public-identity
# SOURCE_TOOLS_SOURCE_UID=source-service-numeric-uid
